{
  "name": "commons-resource-hub",
  "version": "1.0.0",
  "description": "Commons: a digital resource management website for reserving equipment, booking spaces, and tracking service requests. Built for FBLA Website Coding & Development 2026-2027.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "demo": "npm run build && npm run start",
    "reset-db": "node --disable-warning=ExperimentalWarning server/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.7"
  }
}
